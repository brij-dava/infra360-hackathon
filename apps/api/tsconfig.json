{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@infra360/types": ["../../packages/types/dist"],
      "@infra360/shared": ["../../packages/shared/dist"]
    }
  },
  "include": ["src/**/*"]
}
